# Dockerfile.dev — для локального запуска модифицированного Home Assistant
FROM mcr.microsoft.com/vscode/devcontainers/base:debian

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Установка системных зависимостей, включая библиотеки для av==13.1.0
RUN \
    apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bluez \
        ffmpeg \
        libudev-dev \
        libavformat-dev \
        libavcodec-dev \
        libavdevice-dev \
        libavutil-dev \
        libswscale-dev \
        libswresample-dev \
        libavfilter-dev \
        libpcap-dev \
        libturbojpeg0 \
        libyaml-dev \
        libxml2 \
	libzstd-dev \
        git \
        cmake \
        autoconf \
        build-essential \
        pkg-config \
        python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*



# Добавляем go2rtc (опционально, если используется)
COPY --from=ghcr.io/alexxit/go2rtc:latest /usr/local/bin/go2rtc /usr/local/bin/go2rtc

# Копируем uv (современный Python-инструмент)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv



# Создаём пользователя для запуска (но позже переключимся на root для /config)
USER vscode

# Устанавливаем Python и venv
WORKDIR /home/vscode
COPY .python-version ./


ENV VIRTUAL_ENV="/home/vscode/.local/ha-venv"
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN uv pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple numpy av pillow isal PyTurboJPEG==1.8.0

# Клонируем и устанавливаем hass-release (опционально, для dev-сборок)
# RUN git clone --depth 1 https://github.com/home-assistant/hass-release ~/hass-release \
#     && uv pip install -e ~/hass-release/

# Копируем зависимости и устанавливаем их
COPY requirements.txt ./
COPY package_constraints_fix.txt ./
COPY homeassistant/package_constraints.txt homeassistant/package_constraints.txt
RUN uv pip install --index-url https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt -c package_constraints_fix.txt

# Фикс: aiodns 3.x использует pycares type annotations, которых нет в pycares на Python 3.13
# Добавляем 'from __future__ import annotations' чтобы annotations были ленивыми
RUN AIODNS_INIT="$(python -c 'import importlib.util; print(importlib.util.find_spec("aiodns").origin)')" \
    && sed -i '1s/^/from __future__ import annotations\n/' "$AIODNS_INIT"

# Silero VAD: torch CPU-only + silero-vad
RUN UV_HTTP_TIMEOUT=600 uv pip install --index-url https://pypi.tuna.tsinghua.edu.cn/simple --extra-index-url https://download.pytorch.org/whl/cpu torch torchaudio --no-deps \
    && UV_HTTP_TIMEOUT=600 uv pip install --index-url https://pypi.tuna.tsinghua.edu.cn/simple silero-vad onnxruntime

USER root
# Копируем **весь ваш код** внутрь контейнера
COPY . /workspaces/core
WORKDIR /workspaces/core

# Копируем JIT модель из silero-vad пакета к нашему компоненту
RUN SILERO_MODEL=$(python -c "import silero_vad; import pathlib; print(pathlib.Path(silero_vad.__file__).parent / 'data' / 'silero_vad.jit')") \
    && cp "$SILERO_MODEL" /workspaces/core/homeassistant/components/assist_pipeline/silero_vad.jit || true

# Удаляем onnxruntime (не нужен, используем torch JIT), оставляем torch + silero-vad
RUN uv pip uninstall -y onnxruntime || true

# Устанавливаем Home Assistant в режиме разработки
RUN uv pip install --index-url https://pypi.tuna.tsinghua.edu.cn/simple -e .
# Переключаемся на root, чтобы иметь доступ к /config
USER root
WORKDIR /config

# Запуск Home Assistant
CMD ["python", "-m", "homeassistant", "--config", "/config"]
