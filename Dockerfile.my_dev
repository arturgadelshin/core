# Dockerfile.dev — для локального запуска модифицированного Home Assistant
# syntax = docker/dockerfile:1.3
FROM mcr.microsoft.com/vscode/devcontainers/base:debian

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Установка системных зависимостей с повторными попытками
RUN for i in {1..5}; do \
       apt-get update && \
       DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
           bluez \
           ffmpeg \
           libudev-dev \
           libavformat-dev \
           libavcodec-dev \
           libavdevice-dev \
           libavutil-dev \
           libswscale-dev \
           libswresample-dev \
           libavfilter-dev \
           libpcap-dev \
           libturbojpeg0 \
           libyaml-dev \
           libxml2 \
           libzstd-dev \
           git \
           cmake \
           autoconf \
           build-essential \
           pkg-config \
           python3-dev && \
       break; \
       echo "Попытка $i не удалась, повтор через 30 секунд..."; \
       sleep 30; \
    done && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Добавляем go2rtc (опционально, если используется)
COPY --from=ghcr.io/alexxit/go2rtc:latest /usr/local/bin/go2rtc /usr/local/bin/go2rtc

# Копируем uv (современный Python-инструмент)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Создаём пользователя для запуска (но позже переключимся на root для /config)
USER vscode

# Устанавливаем Python и venv
WORKDIR /home/vscode
COPY .python-version ./
RUN uv python install

ENV VIRTUAL_ENV="/home/vscode/.local/ha-venv"
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN uv pip install --no-cache-dir numpy av pillow

# Клонируем и устанавливаем hass-release (опционально, для dev-сборок)
# RUN git clone --depth 1 https://github.com/home-assistant/hass-release ~/hass-release \
#     && uv pip install -e ~/hass-release/

# Копируем зависимости и устанавливаем их
COPY requirements.txt ./
COPY package_constraints_fix.txt ./
COPY homeassistant/package_constraints.txt homeassistant/package_constraints.txt
RUN uv pip install -r requirements.txt -c package_constraints_fix.txt

# Фикс: современная пара pycares 5.x + aiodns 4.x
RUN uv pip install "pycares>=5.0.0" "aiodns==4.0.4" --index-url https://mirrors.aliyun.com/pypi/simple/

# Silero VAD: torch CPU-only (no torchaudio)
RUN UV_HTTP_TIMEOUT=600 uv pip install --index-url https://mirrors.aliyun.com/pypi/simple --extra-index-url https://download.pytorch.org/whl/cpu torch --no-deps \
    && UV_HTTP_TIMEOUT=600 uv pip install --index-url https://mirrors.aliyun.com/pypi/simple silero-vad --no-deps \
    && uv pip install pyspeex-noise pymicro-vad pyring-buffer \
    home-assistant-intents==2025.10.28 file-read-backwards==2.0.0 \
    --index-url https://mirrors.aliyun.com/pypi/simple/
RUN uv pip install PyTurboJPEG --python /home/vscode/.local/ha-venv/bin/python3
USER root
# Копируем **весь ваш код** внутрь контейнера
COPY . /workspaces/core
WORKDIR /workspaces/core

# Копируем JIT модель из silero-vad пакета к нашему компоненту
RUN SILERO_MODEL=$(find /home/vscode/.local/ha-venv -name "silero_vad.jit" -type f 2>/dev/null | head -1) \
    && if [ -n "$SILERO_MODEL" ]; then cp "$SILERO_MODEL" /workspaces/core/homeassistant/components/assist_pipeline/silero_vad.jit; fi

# Устанавливаем Home Assistant в режиме разработки
RUN uv pip install -e .

# Финальная сверка зависимостей (защита от кэша и runtime-переустановок)
RUN uv pip install -r requirements.txt -c package_constraints_fix.txt

# Переключаемся на root, чтобы иметь доступ к /config
USER root
WORKDIR /config

# Запуск Home Assistant
CMD ["python", "-m", "homeassistant", "--config", "/config"]
